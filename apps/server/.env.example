# ───────── Persistencia ─────────
# Backend activo. `memory` (default, dev) o `cosmos` (Sprint 2-14+).
PERSISTENCE_BACKEND=memory

# Solo si PERSISTENCE_BACKEND=cosmos.
# El endpoint es el de la CUENTA de Cosmos (NO el de la base de datos).
# Ejemplo real: https://guinote-cosmos-dev.documents.azure.com:443/
# (la cuenta se llama guinote-cosmos-dev; dentro hay una BD llamada ginote).
COSMOS_ENDPOINT=
# Nombre de la base de datos dentro de la cuenta. El cliente crea los
# contenedores (players, matches, snapshots) si no existen al primer arranque.
COSMOS_DATABASE=ginote

# ─── Autenticación Cosmos ───
# Por defecto se usa Managed Identity (DefaultAzureCredential).
# En local funciona con tu sesión de `az login`.
# En ACA usa la system-assigned identity del container.
#
# Si por algún motivo necesitas usar key explícita (CI sin az login,
# tests rápidos), descomenta la siguiente línea:
# COSMOS_KEY=<primary o secondary key>
# ───────── Cuentas (S3-01) ─────────
# Client ID OAuth de Google (tipo "Aplicación web"). Sin él, el login no
# aparece y todo el mundo juega como invitado. No es secreto.
# Orígenes autorizados en Google Cloud: la URL pública y http://localhost:5173
GOOGLE_CLIENT_ID=
# Firma de la cookie de sesión. Mínimo 32 caracteres aleatorios, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# En producción, sin él el login se desactiva. En ACA, guárdalo como secret.
SESSION_SECRET=
# Cosmos: hace falta un contenedor `users` con partition key `/userId`
# (crearlo en el portal, igual que players/matches/snapshots).
# S4-01: y otro `results` con partition key `/playerId` (historial de partidas).
# S4-05: y otro `pairs` con partition key `/id` (ranking de parejas).
# S5-02: y otro `pushSubs` con partition key `/userId` (avisos push).
# S5-03: y otro `penas` con partition key `/id` (peñas).
# S5-04: y otro `retos` con partition key `/id` (retos entre peñas).
# S5-05: y otro `torneos` con partition key `/id` (torneos).
# ───────── Avisos push (S5-02) ─────────
# Claves VAPID. Generarlas UNA vez con:
#   npx web-push generate-vapid-keys
# La pública no es secreta; la privada, en ACA como secret (secretref:vapid-private-key).
# Sin ellas los avisos push quedan desactivados (los de dentro de la app siguen).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto para Google/Apple/Mozilla si hay problemas con los envíos.
VAPID_SUBJECT=mailto:
# ───────── Torneos (S5-05) ─────────
# Emails (separados por comas) de quien puede crear torneos.
ADMIN_EMAILS=
# ───────── Dominio (SEO) ─────────
# Host canónico: las páginas pedidas por otro host (dominio raíz, *.azurecontainerapps.io)
# se redirigen aquí con 301. Vacío en local. Prod: www.guinoteonline.es
CANONICAL_HOST=
# ───────── Web en otro dominio (S6-02) ─────────
# Orígenes (separados por comas) que pueden llamar a la API con cookies y abrir
# WebSockets. Vacío = como antes (en local, Vite hace de proxy).
# Prod: https://www.guinoteonline.es,https://guinoteonline.es
ALLOWED_ORIGINS=
# Dominio de las cookies de sesión/jugador, para que valgan en `api.`.
# Prod: .guinoteonline.es  (desplegar ANTES de mover el DNS)
COOKIE_DOMAIN=
# false = el contenedor deja de servir la web (cuando ya esté en Static Web Apps).
SERVE_WEB=true
