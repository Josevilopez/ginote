# ───────── Persistencia ─────────
# Backend activo. `memory` (default, dev) o `cosmos` (Sprint 2-14+).
PERSISTENCE_BACKEND=memory

# Solo si PERSISTENCE_BACKEND=cosmos.
# El endpoint es el de la CUENTA de Cosmos (NO el de la base de datos).
# Ejemplo real: https://guinote-cosmos-dev.documents.azure.com:443/
# (la cuenta se llama guinote-cosmos-dev; dentro hay una BD llamada ginote).
COSMOS_ENDPOINT=
# Nombre de la base de datos dentro de la cuenta. El cliente crea los
# contenedores (players, matches, snapshots) si no existen al primer arranque.
COSMOS_DATABASE=ginote

# ─── Autenticación Cosmos ───
# Por defecto se usa Managed Identity (DefaultAzureCredential).
# En local funciona con tu sesión de `az login`.
# En ACA usa la system-assigned identity del container.
#
# Si por algún motivo necesitas usar key explícita (CI sin az login,
# tests rápidos), descomenta la siguiente línea:
# COSMOS_KEY=<primary o secondary key>
# ───────── Cuentas (S3-01) ─────────
# Client ID OAuth de Google (tipo "Aplicación web"). Sin él, el login no
# aparece y todo el mundo juega como invitado. No es secreto.
# Orígenes autorizados en Google Cloud: la URL pública y http://localhost:5173
GOOGLE_CLIENT_ID=
# Firma de la cookie de sesión. Mínimo 32 caracteres aleatorios, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# En producción, sin él el login se desactiva. En ACA, guárdalo como secret.
SESSION_SECRET=
# Cosmos: hace falta un contenedor `users` con partition key `/userId`
# (crearlo en el portal, igual que players/matches/snapshots).
# S4-01: y otro `results` con partition key `/playerId` (historial de partidas).
# S4-05: y otro `pairs` con partition key `/id` (ranking de parejas).
