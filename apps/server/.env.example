# ───────── Persistencia ─────────
# Backend activo. `memory` (default, dev) o `cosmos` (Sprint 2-14+).
PERSISTENCE_BACKEND=memory

# Solo si PERSISTENCE_BACKEND=cosmos.
# El endpoint lo da el portal de Azure, tipo:
#   https://ginote.documents.azure.com:443/
COSMOS_ENDPOINT=
# Nombre de la base de datos. El cliente crea los contenedores
# (players, matches, snapshots) si no existen al primer arranque.
COSMOS_DATABASE=ginote

# ─── Autenticación Cosmos ───
# Por defecto se usa Managed Identity (DefaultAzureCredential).
# En local funciona con tu sesión de `az login`.
# En ACA usa la system-assigned identity del container.
#
# Si por algún motivo necesitas usar key explícita (CI sin az login,
# tests rápidos), descomenta la siguiente línea:
# COSMOS_KEY=<primary o secondary key>