{
  "routes": [
    {
      "route": "/como-se-juega",
      "rewrite": "/como-se-juega/index.html"
    },
    {
      "route": "/privacidad",
      "rewrite": "/privacidad/index.html"
    },
    {
      "route": "/assets/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/cards/*",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "route": "/og.jpg",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      }
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/cards/*",
      "/*.{js,css,png,jpg,jpeg,svg,ico,webp,woff2,json,webmanifest,xml,txt}"
    ]
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json",
    ".xml": "application/xml"
  },
  "globalHeaders": {
    "Cache-Control": "no-cache",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
